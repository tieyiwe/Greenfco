# GreenFCO Server — copy to .env and fill in real values

PORT=5000

# Comma-separated list of allowed frontend origins (e.g. https://yourapp.replit.app)
# Leave blank to allow all origins (dev only)
CLIENT_URL=http://localhost:3003

# REQUIRED: Generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret

# REQUIRED for AI features (GreenBot, Koob Assist, Soil Advisor)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: PostgreSQL connection (app uses in-memory store if not set)
DATABASE_URL=postgresql://user:password@localhost:5432/greenfco
