# ── Required in production (set in Replit Secrets 🔒) ──────────
# Strong random string — used to sign JWT tokens
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Admin panel password
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Optional ────────────────────────────────────────────────────
# Anthropic API key — enables KoobAssist AI and GreenBot
ANTHROPIC_API_KEY=sk-ant-...

# Port (default: 5000 — Replit sets this automatically)
PORT=5000

# Node environment
NODE_ENV=production

# Allowed CORS origins (comma-separated) — leave blank in dev
# CLIENT_URL=https://your-app.replit.app

# Optional: PostgreSQL database (future upgrade from JSON file store)
# DATABASE_URL=postgresql://user:pass@host:5432/greenfco
